# Copia este archivo a .env y rellena los valores

# ── Base de datos ─────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=spotifytracker_db
DB_USER=postgres
DB_PASSWORD=123456789

# ── Spotify ────────────────────────────────────
SPOTIFY_CLIENT_ID=d8b9072b12234502a9764c8f072f6010
SPOTIFY_CLIENT_SECRET=7ba48676606448399bec11b385d1ea3e
SPOTIFY_REDIRECT_URI=http://localhost:8080/login/oauth2/code/spotify

# ── JWT ────────────────────────────────────────
# Genera una clave segura en producción: openssl rand -base64 64
JWT_SECRET=cambia_esto_por_una_clave_larga_segura

# ── URLs ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Recomendado para Docker local: backend fijo y predecible.
VITE_API_BASE_URL=http://localhost:8080
VITE_APP_TITLE=Spotify Tracker

# ── Assistant IA (Gemini) ──────────────────────
# Usa ASSISTANT_AI_PROVIDER=gemini para activar Gemini
ASSISTANT_AI_PROVIDER=mock
GEMINI_API_KEY=AIzaSyA2pHa_MDcYK6f02j6LvihufD7LuyvRt8M
ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASSISTANT_GEMINI_TIMEOUT_SECONDS=20
