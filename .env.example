# Base de datos MySQL local UsuariosTFG
DB_HOST=localhost
DB_PORT=3307
DB_NAME=usuarios_tfg
DB_USER=tfg_user
DB_PASSWORD=tfg_password
DB_TIMEZONE=Europe/Madrid
FLYWAY_ENABLED=false

# Spotify
SPOTIFY_CLIENT_ID=pon_aqui_tu_client_id
SPOTIFY_CLIENT_SECRET=pon_aqui_tu_client_secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/login/oauth2/code/spotify

# JWT
JWT_SECRET=cambia_esto_por_una_clave_larga_segura_de_al_menos_32_caracteres

# Frontend
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Frontend Vite
VITE_API_BASE_URL=http://127.0.0.1:8080
VITE_APP_TITLE="Spotify Tracker"

# Assistant IA
ASSISTANT_AI_PROVIDER=mock
GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-2.5-flash
ASSISTANT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASSISTANT_GEMINI_TIMEOUT_SECONDS=20
